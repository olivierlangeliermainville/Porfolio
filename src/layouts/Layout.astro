---
import '@/styles/global.css';
import Head from '@/components/UI/Head.astro';
import Nav from '@/components/UI/Nav.astro';
import GridLines from '@/components/UI/GridLines.astro';
import Shader from '@/components/UI/Shader.astro';
import MediaViewer from '@/components/UI/MediaViewer.astro';
---

<html lang="en">
  <Head />
  <body id="top">
    <Shader />
    <GridLines />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <MediaViewer />

    <script>
      import { useFade } from '@/composables/useFade';
      import { useGridCenter } from '@/composables/useGridCenter';
      import { useSmoothScroll } from '@/composables/useSmoothScroll';

      useGridCenter();
      useSmoothScroll();
      useFade();
    </script>
  </body>
</html>
