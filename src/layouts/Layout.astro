---
import '@/styles/global.css';
import Head from '@/components/UI/Head.astro';
import Nav from '@/components/UI/Nav.astro';
import Footer from '@/components/UI/Footer.astro';
---

<html lang="en">
  <Head />
  <body id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-xs focus:left-xs focus:z-[100] focus:rounded-xxs focus:bg-primary focus:p-xs focus:text-on-primary"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { useFade } from '@/composables/useFade';

      useFade();
    </script>
  </body>
</html>
