---
/**
 * Top bar: your initials (back to top), the section anchors, the language picker and the theme
 * toggle, from src/data/site.js
 */
import { languages, nav, profile, theme } from '@/data/site';
import Icon from '@/components/Common/Icon.vue';
---

<header>
  <nav class="container-page grid-layout-12 items-start pt-xxs" aria-label="Main">
    <!-- Every item starts a cell in from its grid line, like the text below (--spacing-cell) -->
    <a
      href="#top"
      class="col-span-3 px-cell md:col-span-1 transition-colors duration-(--duration-fast) hover:text-accent"
      aria-label={`${profile.name}, back to top`}
    >
      {profile.initials}
    </a>

    <ul class="col-span-6 flex gap-s px-cell md:col-span-5">
      {nav.map((link) => (
        <li>
          <a href={link.to} class="transition-colors duration-(--duration-fast) hover:text-accent">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <label class="col-span-3 flex flex-col items-end px-cell md:col-start-7 md:items-start">
      <span class="text-caption text-muted">{languages.label}</span>
      <span class="relative flex items-center gap-xxxs">
        <select class="cursor-pointer appearance-none pr-xs">
          {languages.options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
        <Icon name="caret-down" class="pointer-events-none absolute right-0 size-2" />
      </span>
    </label>

    <!-- Shows the current theme, the light: variant swaps the names without waiting for the script -->
    <button
      type="button"
      class="group col-span-3 col-start-10 flex cursor-pointer flex-col items-end px-cell md:items-start"
      data-theme-toggle
    >
      <span class="text-caption text-muted">{theme.label}</span>
      <span class="transition-colors duration-(--duration-fast) group-hover:text-accent">
        <span class="light:hidden">{theme.dark}</span>
        <span class="hidden light:inline">{theme.light}</span>
      </span>
    </button>
  </nav>
</header>

<script>
  // Saved for the next visits (read back in UI/Head.astro). The Shader follows the attribute
  document.querySelector('[data-theme-toggle]')!.addEventListener('click', () => {
    const root = document.documentElement;
    const theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
  });
</script>
