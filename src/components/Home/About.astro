---
import { about, experience } from '@/data/site';
import MaybeLink from '@/components/Common/MaybeLink.vue';
import Tag from '@/components/Common/Tag.vue';
import Text from '@/components/Common/Text.vue';
---

<section id="about" class="container-page border-border grid-layout-1 gap-y-l border-t py-section md:grid-layout-12">
  <Text tag-name="h2" size="heading-2" text={about.title} class="md:col-span-4" data-fade data-scroll />

  <div class="flex flex-col gap-l md:col-span-8 md:col-start-5" data-fade data-scroll data-delay="0.1">
    <div class="flex flex-col gap-xs">
      {about.paragraphs.map((paragraph) => <Text tag-name="p" size="body-1" html text={paragraph} class="max-w-[60ch]" />)}
    </div>

    {
      about.skills?.length > 0 && (
        <ul class="flex flex-wrap gap-xxs" aria-label="Skills">
          {about.skills.map((skill) => (
            <li>
              <Tag text={skill} />
            </li>
          ))}
        </ul>
      )
    }

    {
      experience.length > 0 && (
        <div>
          <Text tag-name="h3" size="label" text="Experience" class="text-muted mb-xs block" />
          <ul class="border-border border-t">
            {experience.map((job) => (
              <li class="border-border border-b">
                <MaybeLink
                  to={job.to}
                  class="grid grid-cols-[1fr_auto] gap-x-xs py-xs transition-opacity md:grid-cols-[1fr_1fr_auto] [&[href]:hover]:opacity-70"
                >
                  <Text size="body-1" text={job.company} />
                  <Text size="body-2" text={job.period} class="text-muted text-right md:order-last" />
                  <Text size="body-2" text={job.role} class="text-muted col-span-2 md:col-span-1" />
                </MaybeLink>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
