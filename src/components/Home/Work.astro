---
import { projects } from '@/data/projects';
import Text from '@/components/Common/Text.vue';
import ProjectList from './ProjectList.vue';
---

<section id="work" class="container-page border-border border-t py-section">
  <div class="mb-l flex items-end justify-between gap-xs" data-fade data-scroll>
    <Text tag-name="h2" size="heading-2" text="Selected work" />
    <Text size="label" class="text-muted" text={`${projects.length} projects`} />
  </div>

  <!-- Hydrated for the tag filter, the list is rendered to html first -->
  <ProjectList client:visible projects={projects} />
</section>
